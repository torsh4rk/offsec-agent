{
  "$schema": "https://opencode.ai/config.json",
  "model": "openai/gpt-5.6-sol-pro",
  "permission": {
    "skill": {"*": "allow"},
    "edit": "ask",
    "bash": {
      "*": "ask",
      "rm -rf *": "deny",
      "sudo *": "ask",
      "nmap *": "ask",
      "sqlmap *": "ask",
      "ffuf *": "ask",
      "nuclei *": "ask"
    },
    "external_directory": "ask",
    "mcp_burp_*": "ask"
  },
  "mcp": {
    "mcp_burp": {
      "type": "remote",
      "url": "http://127.0.0.1:9876/",
      "enabled": true,
      "oauth": false,
      "timeout": 30000
    }
  }
}
